<Project>
  <PropertyGroup>
    <wheeljackVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)VERSION'))</wheeljackVersionFile>
    <wheeljackVersion>$([System.IO.File]::ReadAllText('$(wheeljackVersionFile)').Trim())</wheeljackVersion>
    <wheeljackAssemblyVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(wheeljackVersion)', '-.*$', '')).0</wheeljackAssemblyVersion>
    <Version Condition="'$(Version)' == ''">$(wheeljackVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(wheeljackAssemblyVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(wheeljackAssemblyVersion)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(wheeljackVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="ValidatewheeljackVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(wheeljackVersion)', '^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$'))"
           Text="VERSION must contain a semantic version such as 1.2.3 or 1.2.3-rc.1." />
  </Target>
</Project>
